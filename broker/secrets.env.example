# credbroker secrets. Copy to /etc/credbroker/secrets.env, owned by root with
# group credbroker and mode 0640, so the broker can read it and agents cannot.
# Never commit the real file.

# One 1Password service account token per agent, under the name that agent's
# op_token_key gives in config.toml. Each service account should be able to
# read one vault only.
OP_TOKEN_RESEARCH=
OP_TOKEN_ASSISTANT=

# The MQTT login, if the [mqtt] table in config.toml is used and the server
# needs one. Leave both out to connect without a login.
# MQTT_USERNAME=
# MQTT_PASSWORD=
