<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 launch window: the mark on brand orange. Android 12+
     uses the system splash screen (values-v31/styles.xml) instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_accent" />
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center"
        android:width="192dp"
        android:height="192dp" />
</layer-list>
