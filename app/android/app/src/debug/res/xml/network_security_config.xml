<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (this file lives under src/debug): plain HTTP to a
     LAN test server (put yours here) and to the emulator's host alias. Release
     builds carry no config, so Android refuses cleartext everywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.20</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
