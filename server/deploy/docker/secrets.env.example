# Vouch secrets, read by the vouch service at start (systemd EnvironmentFile).
# Mode 0640, owner root, group vouch. Only needed if you turn the SMS module on.
# Use KEY="value" with \ and " escaped inside the quotes.

# voip.ms API user and API password ([sms] provider = "voipms")
# VOUCH_VOIPMS_USER="you@example.com"
# VOUCH_VOIPMS_API_PASSWORD=""

# The MQTT broker login for incoming texts ([sms.mqtt])
# VOUCH_MQTT_USERNAME="vouch"
# VOUCH_MQTT_PASSWORD=""
